{
  "name": "shopping-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 2 website: shared price history, product pages and deals (Cloudflare Workers + D1).",
  "scripts": {
    "dev": "wrangler dev",
