{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "description": "__MSG_appDescription__",
  "version": "0.2.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appShortName__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "alarms", "notifications", "offscreen"],
  "host_permissions": ["https://www.amazon.in/*", "https://www.flipkart.com/*", "https://www.myntra.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.amazon.in/*", "https://www.flipkart.com/*", "https://www.myntra.com/*"],
      "js": [
        "src/shared/stores.js",
        "src/shared/extract.js",
        "src/shared/insights.js",
        "src/shared/config.js",
        "src/shared/share.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
